# Environment variables for Docker
# - this file will not be added to version control
# - make sure that the file is added to the password manager

DRUPAL_DB_HOST=
DRUPAL_DB_PORT=3306
DRUPAL_DB_NAME=drupal
DRUPAL_DB_USER=
DRUPAL_DB_PASSWORD=""
DRUPAL_TABLE_PREFIX=
DRUPAL_DB_CHARSET=utf8

# User ID for Linux/WSL, check user ID with id -u or id -g
UID=
GID=
